filters:
  and:
    - file.inFolder("_materials")
formulas:
  color: file.asLink(title)
  cost: if(price, "$" + price, "")
properties:
  note.material:
    displayName: Material
  note.title:
    displayName: Color
  note.hex:
    displayName: Hex
  note.hex_source:
    displayName: Hex Source
  note.vendor:
    displayName: Vendor
  note.finish:
    displayName: Finish
  note.line:
    displayName: Line
  note.sheet_size:
    displayName: Sheet
  note.process:
    displayName: Process
  note.price:
    displayName: Price
  note.price_scale:
    displayName: Scale
  note.in_inventory:
    displayName: In Inventory
  note.palettes:
    displayName: Palettes
  note.purchase_url:
    displayName: Buy
  formula.color:
    displayName: Color
  formula.cost:
    displayName: Price
views:
  - type: table
    name: All Colors
    order:
      - formula.color
      - hex
      - hex_source
      - material
      - finish
      - palettes
      - vendor
      - line
      - sheet_size
      - process
      - formula.cost
      - price_scale
      - in_inventory
    sort:
      - property: vendor
        direction: ASC
      - property: title
        direction: ASC
    columnSize:
      formula.color: 260
  - type: table
    name: By Material
    groupBy:
      property: material
      direction: ASC
    order:
      - formula.color
      - hex
      - finish
      - vendor
      - line
      - sheet_size
      - process
    sort:
      - property: vendor
        direction: ASC
      - property: title
        direction: ASC
    columnSize:
      formula.color: 260
  - type: table
    name: By Vendor
    groupBy:
      property: vendor
      direction: ASC
    order:
      - formula.color
      - hex
      - finish
      - sheet_size
      - formula.cost
      - price_scale
      - in_inventory
    sort:
      - property: title
        direction: ASC
    columnSize:
      formula.color: 260
  - type: table
    name: By Finish
    groupBy:
      property: finish
      direction: ASC
    order:
      - formula.color
      - hex
      - vendor
      - sheet_size
      - formula.cost
      - in_inventory
    sort:
      - property: title
        direction: ASC
    columnSize:
      formula.color: 260
  - type: table
    name: In Inventory
    filters:
      and:
        - in_inventory == true
    order:
      - formula.color
      - finish
      - vendor
      - sheet_size
      - formula.cost
    sort:
      - property: title
        direction: ASC
    columnSize:
      formula.color: 260
  - type: table
    name: Reorder
    order:
      - formula.color
      - vendor
      - formula.cost
      - price_scale
      - purchase_url
      - in_inventory
    sort:
      - property: vendor
        direction: ASC
      - property: title
        direction: ASC
    columnSize:
      formula.color: 260
