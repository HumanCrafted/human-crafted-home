filters:
  and:
    - file.inFolder("_docs")
    - or:
        - file.hasTag("bit")
        - file.hasTag("router-bit")
        - file.hasTag("drill-bit")
formulas:
  bit: file.asLink(title)
  dia: if(cutting_diameter, number(cutting_diameter), "")
  loc: if(cutting_length, number(cutting_length), "")
  oal: if(overall_length, number(overall_length), "")
  needs_attention: if(status, status.lower() != "in service", false)
properties:
  note.serial:
    displayName: ID
  note.title:
    displayName: Tool
  note.vendor:
    displayName: Vendor
  note.part_number:
    displayName: Part No.
  note.tool_type:
    displayName: Type
  note.geometry:
    displayName: Geometry
  note.best_for:
    displayName: Best for
  note.profile:
    displayName: Profile
  note.radius:
    displayName: Radius
  note.small_diameter:
    displayName: Pilot
  note.bearing:
    displayName: Bearing
  note.bit_size:
    displayName: Size
  note.decimal_equivalent:
    displayName: Decimal
  note.point_type:
    displayName: Point
  note.length_class:
    displayName: Length Class
  note.max_drilling_depth:
    displayName: Max Depth
  note.max_rpm:
    displayName: Max RPM
  note.flutes:
    displayName: Flutes
  note.shank_diameter:
    displayName: Shank
  note.coating:
    displayName: Coating
  note.material:
    displayName: Material
  note.price:
    displayName: Price
  note.date_purchased:
    displayName: Purchased
  note.status:
    displayName: Status
  note.purchase_url:
    displayName: Buy
  note.in_fusion_library:
    displayName: In Fusion
  formula.bit:
    displayName: Tool
  formula.dia:
    displayName: Dia
  formula.loc:
    displayName: LOC
  formula.oal:
    displayName: OAL
  formula.needs_attention:
    displayName: Needs Attention
views:
  - type: table
    name: All Bits
    filters:
      and:
        - file.hasTag("bit")
    order:
      - serial
      - formula.bit
      - tool_type
      - geometry
      - formula.dia
      - flutes
      - formula.loc
      - formula.oal
      - best_for
      - vendor
      - status
    sort:
      - property: formula.dia
        direction: ASC
      - property: serial
        direction: ASC
    columnSize:
      formula.bit: 300
  - type: table
    name: By Diameter
    filters:
      and:
        - file.hasTag("bit")
    groupBy:
      property: cutting_diameter
      direction: ASC
    order:
      - serial
      - formula.bit
      - geometry
      - flutes
      - formula.loc
      - best_for
      - status
    sort:
      - property: serial
        direction: ASC
  - type: table
    name: By Geometry
    filters:
      and:
        - file.hasTag("bit")
    groupBy:
      property: geometry
      direction: ASC
    order:
      - serial
      - formula.bit
      - formula.dia
      - flutes
      - formula.loc
      - best_for
      - vendor
    sort:
      - property: formula.dia
        direction: ASC
  - type: table
    name: Needs Attention
    filters:
      and:
        - formula.needs_attention == true
    order:
      - serial
      - formula.bit
      - status
      - date_purchased
      - price
      - purchase_url
    sort:
      - property: serial
        direction: ASC
  - type: table
    name: Reorder
    order:
      - serial
      - formula.bit
      - vendor
      - part_number
      - price
      - purchase_url
      - status
    sort:
      - property: vendor
        direction: ASC
  - type: table
    name: Fusion Library
    filters:
      and:
        - file.hasTag("bit")
    order:
      - serial
      - formula.bit
      - in_fusion_library
      - formula.dia
      - flutes
      - formula.loc
    sort:
      - property: serial
        direction: ASC
  - type: table
    name: Router Bits
    filters:
      and:
        - file.hasTag("router-bit")
    order:
      - serial
      - formula.bit
      - profile
      - radius
      - formula.dia
      - shank_diameter
      - bearing
      - best_for
      - vendor
      - status
    sort:
      - property: serial
        direction: ASC
    columnSize:
      formula.bit: 300
  - type: table
    name: Drill Bits
    filters:
      and:
        - file.hasTag("drill-bit")
    order:
      - serial
      - formula.bit
      - bit_size
      - decimal_equivalent
      - point_type
      - length_class
      - formula.oal
      - max_drilling_depth
      - best_for
      - vendor
      - status
    sort:
      - property: serial
        direction: ASC
    columnSize:
      formula.bit: 300
